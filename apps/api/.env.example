# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=local
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000

# JSON array of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Database -------------------------------------------------------------
# Either set DATABASE_URL to a full DSN, or set the POSTGRES_* values below.
# DATABASE_URL wins when both are present, and a sync driver in it
# (postgresql:// or postgresql+psycopg://) is rewritten onto asyncpg.
# DATABASE_URL=postgresql+psycopg://agenttrace:secret@localhost:5432/agenttrace

# When running the API on the host against Docker Compose Postgres, use
# localhost. Inside Compose, the API would use POSTGRES_HOST=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenttrace
POSTGRES_USER=agenttrace
# Required unless DATABASE_URL is set. Generate one: `openssl rand -hex 16`.
POSTGRES_PASSWORD=change-me-locally

# The test suite creates and migrates this database itself; it is never the
# database above, so running tests cannot touch development data.
POSTGRES_TEST_DB=agenttrace_test
