# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=local
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000

# JSON array of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# When running the API on the host against Docker Compose Postgres, use
# localhost. Inside Compose, the API would use POSTGRES_HOST=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenttrace
POSTGRES_USER=agenttrace
# Required. Generate one, e.g. `openssl rand -hex 16`.
POSTGRES_PASSWORD=change-me-locally
