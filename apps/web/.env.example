# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the site itself is served. Link previews (Open Graph, Twitter) need an
# absolute URL for their image, so set this to the public origin when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
