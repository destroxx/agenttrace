# Environment read by the AgentTrace Python SDK.
# Copy to .env and load it however your agent app prefers.

AGENTTRACE_API_URL=http://localhost:8000
# Optional until authentication ships.
AGENTTRACE_API_KEY=

# The project finished runs are uploaded to. Without it the SDK records
# traces in memory and never makes a request.
AGENTTRACE_PROJECT_ID=
# Seconds to wait for an upload before giving up. Default 5. An invalid
# value falls back to the default rather than failing.
AGENTTRACE_TIMEOUT=5
